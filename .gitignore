*.mp4
*.wav
*.jpg
*.png
*.srt
*.pcm
*.part
*.crdownload
*.tmp

# ── 测试/临时产物 ──
work/frames/
work/__pycache__/

# ── 环境与密钥 ──
.env
*.env
.env.*
!.env.example

# ── 打包产物 ──
dist-release/
dist-windows/

